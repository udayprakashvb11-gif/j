Experiment 10
import java.io.*;

public class Program10 {
    public static void main(String[] args) {

        try {
            // I/O Class - File
            File file = new File("sample.txt");

            // FileOutputStream - write bytes
            FileOutputStream fos = new FileOutputStream(file);
            fos.write("Hello Java\n".getBytes());
            fos.close();

            // FileWriter - write characters
            FileWriter fw = new FileWriter(file, true);
            fw.write("Welcome to File Handling\n");
            fw.close();

            // BufferedWriter - write characters
            BufferedWriter bw = new BufferedWriter(new FileWriter(file, true));
            bw.write("Buffered Writer Example\n");
            bw.close();

            // FileInputStream - read bytes
            FileInputStream fis = new FileInputStream(file);
            int ch;
            System.out.println("Using FileInputStream:");
            while ((ch = fis.read()) != -1)
                System.out.print((char) ch);
            fis.close();

            // FileReader - read characters
            FileReader fr = new FileReader(file);
            System.out.println("\nUsing FileReader:");
            while ((ch = fr.read()) != -1)
                System.out.print((char) ch);
            fr.close();

        } catch (IOException e) {
            System.out.println("Error: " + e);
        }
    }
}
