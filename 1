x) max = num;             if (num < min) min = num;         }                  System.out.println("\nSum: " + sum);         System.out.println("Average: " + (double) sum / numbers.length);         System.out.println("Maximum: " + max);         System.out.println("Minimum: " + min);                  // Part C: String Methods         System.out.println("\n===== PART C: STRING METHODS =====");         String str1 = "Hello World";         String str2 = "  Java Programming  ";         String str3 = "hello world";                  System.out.println("Original String: \"" + str1 + "\"");         System.out.println("Length: " + str1.length());         System.out.println("Character at index 4: " + str1.charAt(4));         System.out.println("Substring (0,5): " + str1.substring(0, 5));         System.out.println("Uppercase: " + str1.toUpperCase());         System.out.println("Lowercase: " + str1.toLowerCase());         System.out.println("Replace 'o' with '0': " + str1.replace('o', '0'));         System.out.println("Index of 'World': " + str1.indexOf("World"));         System.out.println("Starts with 'Hello': " + str1.startsWith("Hello"));         System.out.println("Ends with 'World': " + str1.endsWith("World"));         System.out.println("Equals (case-sensitive): " + str1.equals(str3));         System.out.println("Equals (ignore case): "+ str1.equalsIgnoreCase(str3));                                                     System.out.println("Trimmed string: \"" + str2.trim() + "\"");         System.out.println("Concatenation: " + str1.concat(" - Java"));         System.out.println("Split by space: ");         String[] words = str1.split(" ");         for (int i = 0; i < words.length; i++) {             System.out.println("  Word " + (i + 1) + ": " + words[i]);         }                 sc.close();     } } 
