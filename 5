package mathoperations;

public class BasicMath {

    public int add(int a, int b) {
        return a + b;
    }

    public int subtract(int a, int b) {
        return a - b;
    }
}
AdvancedMath.java
package mathoperations;

public class AdvancedMath {

    public int multiply(int a, int b) {
        return a * b;
    }

    public int square(int a) {
        return a * a;
    }
}
