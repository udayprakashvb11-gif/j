package utilities;

public class StringHelper {

    public String upper(String s) {
        return s.toUpperCase();
    }

    public int length(String s) {
        return s.length();
    }
}
ArrayHelper.java
package utilities;

public class ArrayHelper {

    public int sum(int[] a) {

        int sum = 0;

        for (int n : a) {
            sum = sum + n;
        }

        return sum;
    }
}
Experiment5.java
import utilities.*;

public class Experiment5 {

    public static void main(String[] args) {

        StringHelper s = new StringHelper();
        ArrayHelper a = new ArrayHelper();

        System.out.println("Uppercase: " + s.upper("java"));
        System.out.println("Length: " + s.length("Java"));

        int[] n = {10, 20, 30};

        System.out.println("Array Sum: " + a.sum(n));
    }
}
